# YEOP RELEASE v0.3 - scoped to this release only
# The host bridge uses a private physical directory. Do not let mod_dir expose
# that path in a trailing-slash redirect before the React router is loaded.
Options -Indexes
DirectoryIndex index.html
DirectorySlash Off
RewriteEngine On
RewriteOptions AllowNoSlash
RewriteRule ^api/(?:_.*|config\.php)(?:/|$) - [F,L]
RewriteRule ^$ index.html [END]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(mir|band|history(?:/[a-z0-9-]+)?|schedule|gallery|account|admin|review)/?$ $1/index.html [END]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?:mir|band|history(?:/[^/]+)?|schedule|gallery(?:/[^/]+)?|account|admin|review)/?$ index.html [END]
