{
  "name": "mir-cheongwoon-promo-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/finalize-songbook-v3.mjs && node scripts/prepare-songbook-v2.mjs",
    "build": "vite build",
    "prebuild": "node scripts/finalize-songbook-v3.mjs && node scripts/prepare-songbook-v2.mjs",
    "preview": "vite preview",
    "check": "node scripts/check-syntax.mjs",
    "check:backend": "python scripts/check-python.py && node scripts/check-syntax.mjs --php",
    "test": "node --test",
    "pretest": "node scripts/finalize-songbook-v3.mjs && node scripts/prepare-songbook-v2.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0"
  }
}
